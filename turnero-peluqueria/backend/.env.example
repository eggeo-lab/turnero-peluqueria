PORT=3001
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Clave de la bandeja /admin (header x-admin-key). Vacía = bandeja
# deshabilitada: GET /api/turnos responde 503. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=

# Saltos de proxy confiables para leer la IP real (rate limit). En Render
# se usa 1 automáticamente; en local no hace falta.
TRUST_PROXY=

# WhatsApp (Evolution API) — dejar vacío para modo mock (solo loguea en consola)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
ADMIN_WHATSAPP=

# Opcional: ruta del archivo SQLite (default: backend/data.sqlite)
DB_PATH=
